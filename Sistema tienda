
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ControlGastos — Panel Financiero</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
  :root {
    --bg: #0f1117;
    --bg2: #161b27;
    --bg3: #1e2535;
    --bg4: #252d3d;
    --border: rgba(255,255,255,0.07);
    --border2: rgba(255,255,255,0.13);
    --text: #e8eaf0;
    --text2: #8b92a8;
    --text3: #555f7a;
    --accent: #3b82f6;
    --accent2: #1d4ed8;
    --green: #22c55e;
    --green-bg: rgba(34,197,94,0.1);
    --red: #ef4444;
    --red-bg: rgba(239,68,68,0.1);
    --amber: #f59e0b;
    --amber-bg: rgba(245,158,11,0.1);
    --font: 'DM Sans', sans-serif;
    --mono: 'DM Mono', monospace;
    --radius: 10px;
    --radius-lg: 16px;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: var(--font); background: var(--bg); color: var(--text); min-height: 100vh; display: flex; }

  /* SIDEBAR */
  .sidebar {
    width: 220px; flex-shrink: 0; background: var(--bg2);
    border-right: 1px solid var(--border); display: flex;
    flex-direction: column; padding: 0; position: fixed;
    top: 0; left: 0; height: 100vh; z-index: 10;
  }
  .logo {
    padding: 24px 20px 20px;
    border-bottom: 1px solid var(--border);
  }
  .logo-title { font-size: 15px; font-weight: 600; color: var(--text); letter-spacing: -0.3px; }
  .logo-sub { font-size: 11px; color: var(--text3); margin-top: 2px; font-family: var(--mono); }
  .nav { padding: 12px 10px; flex: 1; }
  .nav-item {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 12px; border-radius: 8px;
    font-size: 13px; color: var(--text2); cursor: pointer;
    transition: all .15s; margin-bottom: 2px; user-select: none;
  }
  .nav-item:hover { background: var(--bg3); color: var(--text); }
  .nav-item.active { background: rgba(59,130,246,0.12); color: var(--accent); font-weight: 500; }
  .nav-item svg { width: 16px; height: 16px; flex-shrink: 0; }
  .nav-section { font-size: 10px; color: var(--text3); padding: 14px 12px 6px; text-transform: uppercase; letter-spacing: 1px; font-family: var(--mono); }
  .sidebar-footer { padding: 16px 20px; border-top: 1px solid var(--border); }
  .sidebar-badge { font-size: 11px; color: var(--text3); font-family: var(--mono); }

  /* MAIN */
  .main { margin-left: 220px; flex: 1; padding: 28px 32px; min-height: 100vh; }
  .page { display: none; }
  .page.active { display: block; }

  /* TOPBAR */
  .topbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28px; }
  .topbar-title { font-size: 22px; font-weight: 600; letter-spacing: -0.5px; }
  .topbar-sub { font-size: 13px; color: var(--text2); margin-top: 2px; }
  .topbar-actions { display: flex; gap: 8px; }

  /* BUTTONS */
  .btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 16px; border-radius: 8px; font-size: 13px;
    font-family: var(--font); cursor: pointer; transition: all .15s;
    border: 1px solid var(--border2); background: var(--bg3);
    color: var(--text); font-weight: 500;
  }
  .btn:hover { background: var(--bg4); border-color: var(--border2); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .btn.primary:hover { background: var(--accent2); border-color: var(--accent2); }
  .btn.sm { padding: 5px 10px; font-size: 12px; }
  .btn.danger { background: var(--red-bg); border-color: rgba(239,68,68,0.25); color: var(--red); }
  .btn svg { width: 14px; height: 14px; }

  /* METRICS */
  .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-bottom: 24px; }
  .metric {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 20px;
  }
  .metric-label { font-size: 11px; color: var(--text3); text-transform: uppercase; letter-spacing: .8px; font-family: var(--mono); margin-bottom: 10px; }
  .metric-val { font-size: 24px; font-weight: 600; letter-spacing: -1px; color: var(--text); }
  .metric-sub { font-size: 12px; margin-top: 6px; color: var(--text2); }
  .metric-sub.up { color: var(--red); }
  .metric-sub.down { color: var(--green); }

  /* CARDS */
  .card { background: var(--bg2); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 20px; margin-bottom: 20px; }
  .card-title { font-size: 13px; font-weight: 500; color: var(--text2); text-transform: uppercase; letter-spacing: .6px; font-family: var(--mono); margin-bottom: 16px; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }

  /* ALERTS */
  .alerts-wrap { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  .alert-pill {
    display: flex; align-items: center; gap: 6px;
    padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 500;
  }
  .alert-pill.red { background: var(--red-bg); color: var(--red); border: 1px solid rgba(239,68,68,0.2); }
  .alert-pill.amber { background: var(--amber-bg); color: var(--amber); border: 1px solid rgba(245,158,11,0.2); }
  .alert-pill.green { background: var(--green-bg); color: var(--green); border: 1px solid rgba(34,197,94,0.2); }

  /* TABLE */
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  thead th {
    text-align: left; padding: 10px 14px;
    color: var(--text3); font-weight: 500; font-size: 11px;
    text-transform: uppercase; letter-spacing: .6px; font-family: var(--mono);
    border-bottom: 1px solid var(--border); white-space: nowrap;
  }
  tbody td { padding: 11px 14px; border-bottom: 1px solid var(--border); color: var(--text); vertical-align: middle; }
  tbody tr:last-child td { border-bottom: none; }
  tbody tr:hover td { background: rgba(255,255,255,0.02); }

  /* BADGES */
  .badge { display: inline-flex; align-items: center; padding: 3px 9px; border-radius: 20px; font-size: 11px; font-weight: 500; white-space: nowrap; }
  .badge.vencido { background: var(--red-bg); color: var(--red); }
  .badge.pendiente { background: var(--amber-bg); color: var(--amber); }
  .badge.pagado { background: var(--green-bg); color: var(--green); }
  .badge.programado { background: rgba(255,255,255,0.05); color: var(--text2); }
  .badge.fijo { background: rgba(59,130,246,0.1); color: var(--accent); }
  .badge.variable { background: rgba(139,92,246,0.1); color: #a78bfa; }
  .badge.alta { color: var(--red); }
  .badge.media { color: var(--amber); }
  .badge.baja { color: var(--green); }

  /* FORM / MODAL */
  .modal-overlay {
    display: none; position: fixed; inset: 0;
    background: rgba(0,0,0,0.7); z-index: 100;
    align-items: center; justify-content: center;
    backdrop-filter: blur(4px);
  }
  .modal-overlay.open { display: flex; }
  .modal {
    background: var(--bg2); border: 1px solid var(--border2);
    border-radius: var(--radius-lg); padding: 24px;
    width: 540px; max-width: 95vw; max-height: 88vh; overflow-y: auto;
  }
  .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .modal-title { font-size: 16px; font-weight: 600; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .form-group { display: flex; flex-direction: column; gap: 6px; }
  .form-group.full { grid-column: 1 / -1; }
  label { font-size: 11px; color: var(--text2); text-transform: uppercase; letter-spacing: .6px; font-family: var(--mono); }
  input, select, textarea {
    background: var(--bg3); border: 1px solid var(--border2);
    border-radius: 8px; padding: 9px 12px; font-size: 13px;
    color: var(--text); font-family: var(--font);
    transition: border-color .15s; width: 100%;
  }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent); }
  textarea { resize: vertical; min-height: 60px; }
  select option { background: var(--bg3); }

  /* STATS */
  .bar-wrap { margin-bottom: 10px; }
  .bar-label { display: flex; justify-content: space-between; font-size: 12px; color: var(--text2); margin-bottom: 5px; }
  .bar-track { height: 6px; background: var(--bg3); border-radius: 3px; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 3px; transition: width .4s ease; }

  .stat-row { display: flex; justify-content: space-between; align-items: center; padding: 9px 0; border-bottom: 1px solid var(--border); font-size: 13px; }
  .stat-row:last-child { border-bottom: none; }

  /* LOADING */
  .loader { display: flex; align-items: center; justify-content: center; padding: 60px; color: var(--text3); font-size: 13px; gap: 10px; }
  .spinner { width: 16px; height: 16px; border: 2px solid var(--border2); border-top-color: var(--accent); border-radius: 50%; animation: spin .7s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* EMPTY */
  .empty { text-align: center; padding: 48px; color: var(--text3); font-size: 13px; }

  /* SUPABASE CONFIG BANNER */
  .config-banner {
    background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.25);
    border-radius: var(--radius); padding: 14px 18px; margin-bottom: 20px;
    font-size: 13px; color: var(--amber); display: flex; align-items: center; gap: 10px;
  }

  /* PROGRESS RING */
  .ring-wrap { display: flex; align-items: center; gap: 16px; margin-bottom: 10px; }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .sidebar { width: 60px; }
    .nav-item span, .logo-title, .logo-sub, .nav-section, .sidebar-footer { display: none; }
    .main { margin-left: 60px; padding: 16px; }
    .grid2 { grid-template-columns: 1fr; }
    .form-grid { grid-template-columns: 1fr; }
    .metrics { grid-template-columns: 1fr 1fr; }
  }
</style>
</head>
<body>

<!-- SIDEBAR -->
<aside class="sidebar">
  <div class="logo">
    <div class="logo-title">ControlGastos</div>
    <div class="logo-sub">v1.0 · financiero</div>
  </div>
  <nav class="nav">
    <div class="nav-section">Principal</div>
    <div class="nav-item active" onclick="showPage('dashboard',this)">
      <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
      <span>Dashboard</span>
    </div>
    <div class="nav-item" onclick="showPage('vencimientos',this)">
      <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
      <span>Vencimientos</span>
    </div>
    <div class="nav-item" onclick="showPage('gastos',this)">
      <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 12h6M9 16h4"/></svg>
      <span>Gastos</span>
    </div>
    <div class="nav-section">Análisis</div>
    <div class="nav-item" onclick="showPage('estadisticas',this)">
      <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M7 16l4-4 4 4 4-8"/></svg>
      <span>Estadísticas</span>
    </div>
    <div class="nav-section">Sistema</div>
    <div class="nav-item" onclick="showPage('config',this)">
      <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
      <span>Configuración</span>
    </div>
  </nav>
  <div class="sidebar-footer">
    <div class="sidebar-badge" id="db-status">● demo</div>
  </div>
</aside>

<!-- MAIN -->
<main class="main">

  <!-- DASHBOARD -->
  <div class="page active" id="page-dashboard">
    <div class="topbar">
      <div>
        <div class="topbar-title">Dashboard</div>
        <div class="topbar-sub" id="dash-fecha">Cargando...</div>
      </div>
      <div class="topbar-actions">
        <button class="btn primary" onclick="openModal()">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
          Nuevo gasto
        </button>
      </div>
    </div>
    <div id="config-banner" class="config-banner" style="display:none">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
      Modo demo activo. Para conectar Supabase, editá las variables SUPABASE_URL y SUPABASE_KEY en el archivo.
    </div>
    <div class="metrics" id="metrics-dash"></div>
    <div class="alerts-wrap" id="alerts-dash"></div>
    <div class="grid2">
      <div class="card">
        <div class="card-title">Próximos vencimientos</div>
        <div id="proximos-dash"></div>
      </div>
      <div class="card">
        <div class="card-title">Por categoría</div>
        <div id="cat-dash"></div>
      </div>
    </div>
    <div class="card">
      <div class="card-title">Evolución mensual</div>
      <div style="position:relative;height:200px">
        <canvas id="evo-chart" role="img" aria-label="Evolución de gastos mensuales"></canvas>
      </div>
    </div>
  </div>

  <!-- VENCIMIENTOS -->
  <div class="page" id="page-vencimientos">
    <div class="topbar">
      <div>
        <div class="topbar-title">Vencimientos</div>
        <div class="topbar-sub">Control de fechas y estados de pago</div>
      </div>
      <div class="topbar-actions">
        <select id="fv-estado" onchange="renderVenc()" style="width:auto;padding:8px 12px">
          <option value="">Todos</option><option>Pendiente</option><option>Pagado</option><option>Vencido</option>
        </select>
        <select id="fv-tipo" onchange="renderVenc()" style="width:auto;padding:8px 12px">
          <option value="">Fijo / Variable</option><option>Fijo</option><option>Variable</option>
        </select>
        <button class="btn primary" onclick="openModal()">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
          Nuevo
        </button>
      </div>
    </div>
    <div class="card" style="padding:0;overflow:hidden">
      <div class="table-wrap">
        <table>
          <thead><tr>
            <th>Descripción</th><th>Categoría</th><th>Tipo</th>
            <th>Monto</th><th>Vencimiento</th><th>Estado</th>
            <th>Prioridad</th><th>Acción</th>
          </tr></thead>
          <tbody id="venc-body"></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- GASTOS -->
  <div class="page" id="page-gastos">
    <div class="topbar">
      <div>
        <div class="topbar-title">Todos los gastos</div>
        <div class="topbar-sub">Historial completo</div>
      </div>
      <div class="topbar-actions">
        <button class="btn primary" onclick="openModal()">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
          Nuevo gasto
        </button>
      </div>
    </div>
    <div class="card" style="padding:0;overflow:hidden">
      <div class="table-wrap">
        <table>
          <thead><tr>
            <th>Descripción</th><th>Categoría</th><th>Tipo</th>
            <th>Monto</th><th>Vencimiento</th><th>Estado</th>
            <th>Recurrente</th><th>Observaciones</th>
          </tr></thead>
          <tbody id="gastos-body"></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ESTADÍSTICAS -->
  <div class="page" id="page-estadisticas">
    <div class="topbar">
      <div>
        <div class="topbar-title">Estadísticas</div>
        <div class="topbar-sub">Análisis financiero del período</div>
      </div>
    </div>
    <div class="metrics" id="metrics-stats"></div>
    <div class="grid2">
      <div class="card">
        <div class="card-title">Top gastos del período</div>
        <div id="top-gastos"></div>
      </div>
      <div class="card">
        <div class="card-title">Distribución por categoría</div>
        <div id="dist-cat"></div>
      </div>
    </div>
    <div class="card">
      <div class="card-title">Comparador histórico — EPEC</div>
      <div id="hist-comparador"></div>
    </div>
  </div>

  <!-- CONFIGURACIÓN -->
  <div class="page" id="page-config">
    <div class="topbar">
      <div>
        <div class="topbar-title">Configuración</div>
        <div class="topbar-sub">Conexión Supabase y preferencias</div>
      </div>
    </div>
    <div class="card" style="max-width:520px">
      <div class="card-title">Conexión Supabase</div>
      <p style="font-size:13px;color:var(--text2);margin-bottom:16px;line-height:1.6">
        Para conectar la base de datos real, editá las primeras dos líneas del archivo <code style="background:var(--bg3);padding:2px 6px;border-radius:4px;font-size:12px">index.html</code> en el bloque de configuración:
      </p>
      <div style="background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:16px;font-family:var(--mono);font-size:12px;color:var(--text2);line-height:1.8">
        const SUPABASE_URL = '<span style="color:var(--accent)">https://xxxx.supabase.co</span>';<br>
        const SUPABASE_KEY = '<span style="color:var(--accent)">tu-anon-key-aqui</span>';
      </div>
      <div style="margin-top:16px;padding:12px;background:var(--green-bg);border:1px solid rgba(34,197,94,0.2);border-radius:8px;font-size:12px;color:var(--green)">
        Las claves las encontrás en Supabase → Settings → API
      </div>

      <div style="margin-top:24px" class="card-title">SQL para crear la tabla</div>
      <p style="font-size:13px;color:var(--text2);margin-bottom:12px">Ejecutá esto en Supabase → SQL Editor:</p>
      <div style="background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:16px;font-family:var(--mono);font-size:11px;color:var(--text2);line-height:1.9;white-space:pre-wrap">create table gastos (
  id uuid default gen_random_uuid() primary key,
  descripcion text not null,
  categoria text,
  tipo text default 'Fijo',
  monto numeric not null default 0,
  fecha_vencimiento date,
  fecha_pago date,
  estado text default 'Pendiente',
  prioridad text default 'Media',
  medio_pago text,
  recurrente text default 'No',
  observaciones text,
  created_at timestamptz default now()
);

alter table gastos enable row level security;
create policy "public access" on gastos for all using (true);</div>
      <button class="btn" style="margin-top:12px" onclick="copiarSQL()">Copiar SQL</button>
    </div>

    <div class="card" style="max-width:520px;margin-top:0">
      <div class="card-title">Alertas de vencimiento</div>
      <div style="display:flex;flex-direction:column;gap:10px">
        <label style="display:flex;align-items:center;gap:10px;font-size:13px;cursor:pointer;text-transform:none;letter-spacing:0;color:var(--text)"><input type="checkbox" checked> Avisar 1 día antes</label>
        <label style="display:flex;align-items:center;gap:10px;font-size:13px;cursor:pointer;text-transform:none;letter-spacing:0;color:var(--text)"><input type="checkbox" checked> Avisar 3 días antes</label>
        <label style="display:flex;align-items:center;gap:10px;font-size:13px;cursor:pointer;text-transform:none;letter-spacing:0;color:var(--text)"><input type="checkbox" checked> Avisar 7 días antes</label>
        <label style="display:flex;align-items:center;gap:10px;font-size:13px;cursor:pointer;text-transform:none;letter-spacing:0;color:var(--text)"><input type="checkbox"> Avisar 15 días antes</label>
      </div>
      <div style="margin-top:16px" class="card-title">Aumento anormal — alertar si supera</div>
      <div style="display:flex;align-items:center;gap:8px;margin-top:4px">
        <input type="number" value="20" style="width:80px"> <span style="font-size:13px;color:var(--text2)">% respecto al promedio</span>
      </div>
    </div>
  </div>

</main>

<!-- MODAL NUEVO GASTO -->
<div class="modal-overlay" id="modal-overlay">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title">Nuevo gasto</span>
      <button class="btn sm" onclick="closeModal()">✕ Cerrar</button>
    </div>
    <div class="form-grid">
      <div class="form-group full">
        <label>Descripción</label>
        <input type="text" id="f-desc" placeholder="Ej: EPEC Mayo, Monotributo...">
      </div>
      <div class="form-group">
        <label>Categoría</label>
        <select id="f-cat">
          <option>Impuesto</option><option>Servicio</option><option>Sueldo</option>
          <option>Proveedor</option><option>Deuda</option><option>Otro</option>
        </select>
      </div>
      <div class="form-group">
        <label>Tipo</label>
        <select id="f-tipo"><option>Fijo</option><option>Variable</option></select>
      </div>
      <div class="form-group">
        <label>Monto ($)</label>
        <input type="number" id="f-monto" placeholder="0">
      </div>
      <div class="form-group">
        <label>Fecha vencimiento</label>
        <input type="date" id="f-fecha">
      </div>
      <div class="form-group">
        <label>Estado</label>
        <select id="f-estado">
          <option>Pendiente</option><option>Pagado</option><option>Vencido</option>
        </select>
      </div>
      <div class="form-group">
        <label>Prioridad</label>
        <select id="f-prioridad"><option>Alta</option><option>Media</option><option>Baja</option></select>
      </div>
      <div class="form-group">
        <label>Medio de pago</label>
        <select id="f-medio">
          <option>Transferencia</option><option>Efectivo</option><option>Débito automático</option>
        </select>
      </div>
      <div class="form-group">
        <label>Recurrente</label>
        <select id="f-recurrente"><option>No</option><option>Sí</option></select>
      </div>
      <div class="form-group full">
        <label>Observaciones</label>
        <textarea id="f-obs" placeholder="Notas opcionales..."></textarea>
      </div>
    </div>
    <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px">
      <button class="btn" onclick="closeModal()">Cancelar</button>
      <button class="btn primary" onclick="guardarGasto()">Guardar gasto</button>
    </div>
  </div>
</div>

<script>
// ═══════════════════════════════════════════
//  CONFIGURACIÓN — editá estas dos líneas
// ═══════════════════════════════════════════
const SUPABASE_URL = 'TU_SUPABASE_URL'
const SUPABASE_KEY = 'TU_SUPABASE_ANON_KEY'
// ═══════════════════════════════════════════

const DEMO_MODE = !SUPABASE_URL.startsWith('https://')
let db = null
if (!DEMO_MODE) {
  db = supabase.createClient(SUPABASE_URL, SUPABASE_KEY)
  document.getElementById('db-status').textContent = '● conectado'
  document.getElementById('db-status').style.color = '#22c55e'
} else {
  document.getElementById('config-banner').style.display = 'flex'
}

const fmt = n => '$' + Math.round(n).toLocaleString('es-AR')
const today = new Date()
const todayStr = today.toISOString().slice(0,10)

// Datos demo
const DEMO = [
  {id:'d1',descripcion:'EPEC Mayo',categoria:'Servicio',tipo:'Fijo',monto:171000,fecha_vencimiento:'2026-05-26',fecha_pago:null,estado:'Pendiente',prioridad:'Alta',medio_pago:'Débito automático',recurrente:'Sí',observaciones:''},
  {id:'d2',descripcion:'Monotributo',categoria:'Impuesto',tipo:'Fijo',monto:85000,fecha_vencimiento:'2026-05-20',fecha_pago:null,estado:'Vencido',prioridad:'Alta',medio_pago:'Transferencia',recurrente:'Sí',observaciones:''},
  {id:'d3',descripcion:'Internet Fibra',categoria:'Servicio',tipo:'Fijo',monto:38000,fecha_vencimiento:'2026-05-27',fecha_pago:null,estado:'Pendiente',prioridad:'Media',medio_pago:'Débito automático',recurrente:'Sí',observaciones:''},
  {id:'d4',descripcion:'Sueldo empleado',categoria:'Sueldo',tipo:'Fijo',monto:620000,fecha_vencimiento:'2026-05-31',fecha_pago:null,estado:'Pendiente',prioridad:'Alta',medio_pago:'Transferencia',recurrente:'Sí',observaciones:''},
  {id:'d5',descripcion:'Proveedor insumos',categoria:'Proveedor',tipo:'Variable',monto:340000,fecha_vencimiento:'2026-05-29',fecha_pago:null,estado:'Pendiente',prioridad:'Alta',medio_pago:'Transferencia',recurrente:'No',observaciones:''},
  {id:'d6',descripcion:'Alquiler local',categoria:'Servicio',tipo:'Fijo',monto:280000,fecha_vencimiento:'2026-05-05',fecha_pago:'2026-05-04',estado:'Pagado',prioridad:'Alta',medio_pago:'Transferencia',recurrente:'Sí',observaciones:''},
  {id:'d7',descripcion:'Seguro comercio',categoria:'Servicio',tipo:'Fijo',monto:42000,fecha_vencimiento:'2026-05-10',fecha_pago:'2026-05-09',estado:'Pagado',prioridad:'Media',medio_pago:'Débito automático',recurrente:'Sí',observaciones:''},
  {id:'d8',descripcion:'Publicidad Meta',categoria:'Servicio',tipo:'Variable',monto:95000,fecha_vencimiento:'2026-05-15',fecha_pago:'2026-05-15',estado:'Pagado',prioridad:'Media',medio_pago:'Transferencia',recurrente:'No',observaciones:''},
  {id:'d9',descripcion:'Flete distribución',categoria:'Proveedor',tipo:'Variable',monto:78000,fecha_vencimiento:'2026-05-22',fecha_pago:'2026-05-21',estado:'Pagado',prioridad:'Baja',medio_pago:'Efectivo',recurrente:'No',observaciones:''},
  {id:'d10',descripcion:'ARBA Ingresos Brutos',categoria:'Impuesto',tipo:'Fijo',monto:110000,fecha_vencimiento:'2026-05-28',fecha_pago:null,estado:'Pendiente',prioridad:'Alta',medio_pago:'Transferencia',recurrente:'Sí',observaciones:''},
]

let gastos = []

async function cargarGastos() {
  if (DEMO_MODE) { gastos = [...DEMO]; return }
  const { data, error } = await db.from('gastos').select('*').order('fecha_vencimiento', { ascending: true })
  if (!error && data) gastos = data
  else gastos = [...DEMO]
}

function diasHasta(f) {
  return Math.ceil((new Date(f) - today) / (1000*60*60*24))
}

function showPage(id, el) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'))
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'))
  document.getElementById('page-' + id).classList.add('active')
  el.classList.add('active')
  if (id === 'dashboard') renderDashboard()
  if (id === 'vencimientos') renderVenc()
  if (id === 'gastos') renderGastos()
  if (id === 'estadisticas') renderStats()
}

function estadoBadge(e) {
  const m = {Vencido:'vencido',Pendiente:'pendiente',Pagado:'pagado'}
  return `<span class="badge ${m[e]||'programado'}">${e}</span>`
}
function tipoBadge(t) { return `<span class="badge ${t==='Fijo'?'fijo':'variable'}">${t}</span>` }

// DASHBOARD
function renderDashboard() {
  const mes = today.toLocaleString('es-AR', {month:'long', year:'numeric'})
  document.getElementById('dash-fecha').textContent = 'Resumen operativo · ' + mes.charAt(0).toUpperCase() + mes.slice(1)

  const total = gastos.reduce((a,g) => a + Number(g.monto), 0)
  const fijos = gastos.filter(g => g.tipo==='Fijo').reduce((a,g) => a + Number(g.monto), 0)
  const variables = gastos.filter(g => g.tipo==='Variable').reduce((a,g) => a + Number(g.monto), 0)
  const vencidos = gastos.filter(g => g.estado==='Vencido').length
  const pend7 = gastos.filter(g => g.estado==='Pendiente' && diasHasta(g.fecha_vencimiento) <= 7 && diasHasta(g.fecha_vencimiento) >= 0)
  const impacto7 = pend7.reduce((a,g) => a + Number(g.monto), 0)

  document.getElementById('metrics-dash').innerHTML = `
    <div class="metric"><div class="metric-label">Total del mes</div><div class="metric-val">${fmt(total)}</div><div class="metric-sub up">+19% vs promedio trim.</div></div>
    <div class="metric"><div class="metric-label">Gastos fijos</div><div class="metric-val">${fmt(fijos)}</div><div class="metric-sub">${Math.round(fijos/total*100)}% del total</div></div>
    <div class="metric"><div class="metric-label">Gastos variables</div><div class="metric-val">${fmt(variables)}</div><div class="metric-sub">${Math.round(variables/total*100)}% del total</div></div>
    <div class="metric"><div class="metric-label">Vencidos</div><div class="metric-val" style="color:var(--red)">${vencidos}</div><div class="metric-sub up">requieren atención</div></div>
    <div class="metric"><div class="metric-label">Impacto próx. 7 días</div><div class="metric-val">${fmt(impacto7)}</div><div class="metric-sub up">en caja</div></div>
  `

  const alertas = []
  gastos.forEach(g => {
    if (g.estado === 'Vencido') alertas.push({t: g.descripcion + ' está vencido', c:'red'})
    else if (g.estado === 'Pendiente') {
      const d = diasHasta(g.fecha_vencimiento)
      if (d === 0) alertas.push({t: g.descripcion + ' vence hoy', c:'red'})
      else if (d <= 3 && d > 0) alertas.push({t: g.descripcion + ' vence en ' + d + ' días', c:'amber'})
      else if (d <= 7 && d > 0) alertas.push({t: g.descripcion + ' vence en ' + d + ' días', c:'amber'})
    }
  })
  if (alertas.length === 0) alertas.push({t:'Sin alertas activas', c:'green'})
  document.getElementById('alerts-dash').innerHTML = alertas.slice(0,6).map(a =>
    `<div class="alert-pill ${a.c}">● ${a.t}</div>`
  ).join('')

  const pendSort = gastos.filter(g => g.estado !== 'Pagado').sort((a,b) => new Date(a.fecha_vencimiento) - new Date(b.fecha_vencimiento)).slice(0,5)
  document.getElementById('proximos-dash').innerHTML = pendSort.length ? pendSort.map(g => {
    const d = diasHasta(g.fecha_vencimiento)
    const col = g.estado==='Vencido' ? 'var(--red)' : d <= 3 ? 'var(--amber)' : 'var(--text2)'
    const label = g.estado==='Vencido' ? 'Vencido' : d === 0 ? 'Hoy' : 'En ' + d + ' días'
    return `<div class="stat-row"><span>${g.descripcion}</span><span style="color:${col};font-size:12px">${label}</span><span style="font-weight:500">${fmt(g.monto)}</span></div>`
  }).join('') : '<div class="empty">Todo al día ✓</div>'

  const cats = {}
  gastos.forEach(g => { cats[g.categoria] = (cats[g.categoria]||0) + Number(g.monto) })
  const catSort = Object.entries(cats).sort((a,b) => b[1]-a[1])
  const barColors = ['#3b82f6','#22c55e','#f59e0b','#a78bfa','#ef4444']
  document.getElementById('cat-dash').innerHTML = catSort.map(([c,v],i) => {
    const pct = Math.round(v/total*100)
    return `<div class="bar-wrap">
      <div class="bar-label"><span>${c}</span><span>${pct}% · ${fmt(v)}</span></div>
      <div class="bar-track"><div class="bar-fill" style="width:${pct}%;background:${barColors[i%barColors.length]}"></div></div>
    </div>`
  }).join('')

  if (!window._evoChart) {
    const ctx = document.getElementById('evo-chart').getContext('2d')
    window._evoChart = new Chart(ctx, {
      type: 'line',
      data: {
        labels: ['Ene','Feb','Mar','Abr','May'],
        datasets: [{
          label: 'Gastos', data: [1800000,2100000,2300000,2600000,total],
          borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,0.08)',
          fill: true, tension: 0.35, pointRadius: 5,
          pointBackgroundColor: '#3b82f6', pointBorderColor: '#0f1117', pointBorderWidth: 2
        }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: { ticks: { color:'#555f7a', callback: v => '$' + Math.round(v/1000) + 'k' }, grid: { color:'rgba(255,255,255,0.04)' } },
          x: { ticks: { color:'#555f7a' }, grid: { display: false } }
        }
      }
    })
  } else {
    window._evoChart.data.datasets[0].data[4] = total
    window._evoChart.update()
  }
}

// VENCIMIENTOS
function renderVenc() {
  const fE = document.getElementById('fv-estado').value
  const fT = document.getElementById('fv-tipo').value
  let rows = gastos.filter(g => (!fE || g.estado===fE) && (!fT || g.tipo===fT))
  rows.sort((a,b) => new Date(a.fecha_vencimiento) - new Date(b.fecha_vencimiento))
  document.getElementById('venc-body').innerHTML = rows.length ? rows.map(g => {
    const d = diasHasta(g.fecha_vencimiento)
    const fechaColor = g.estado==='Vencido' ? 'color:var(--red)' : d<=3 ? 'color:var(--amber)' : ''
    return `<tr>
      <td style="font-weight:500">${g.descripcion}</td>
      <td style="color:var(--text2)">${g.categoria}</td>
      <td>${tipoBadge(g.tipo)}</td>
      <td style="font-weight:500;font-family:var(--mono)">${fmt(g.monto)}</td>
      <td style="${fechaColor};font-family:var(--mono)">${g.fecha_vencimiento}</td>
      <td>${estadoBadge(g.estado)}</td>
      <td><span class="badge ${(g.prioridad||'').toLowerCase()}">${g.prioridad}</span></td>
      <td><button class="btn sm" onclick="marcarPagado('${g.id}')">✓ Pagar</button></td>
    </tr>`
  }).join('') : '<tr><td colspan="8" style="text-align:center;padding:32px;color:var(--text3)">Sin resultados</td></tr>'
}

// GASTOS
function renderGastos() {
  const rows = [...gastos].reverse()
  document.getElementById('gastos-body').innerHTML = rows.map(g => `
    <tr>
      <td style="font-weight:500">${g.descripcion}</td>
      <td style="color:var(--text2)">${g.categoria}</td>
      <td>${tipoBadge(g.tipo)}</td>
      <td style="font-weight:500;font-family:var(--mono)">${fmt(g.monto)}</td>
      <td style="font-family:var(--mono);color:var(--text2)">${g.fecha_vencimiento}</td>
      <td>${estadoBadge(g.estado)}</td>
      <td><span class="badge ${g.recurrente==='Sí'?'fijo':'programado'}">${g.recurrente==='Sí'?'Recurrente':'Una vez'}</span></td>
      <td style="color:var(--text3);font-size:12px">${g.observaciones||'—'}</td>
    </tr>`).join('')
}

// ESTADÍSTICAS
function renderStats() {
  const total = gastos.reduce((a,g) => a + Number(g.monto), 0)
  const pagado = gastos.filter(g => g.estado==='Pagado').reduce((a,g) => a + Number(g.monto), 0)
  const pendiente = total - pagado
  document.getElementById('metrics-stats').innerHTML = `
    <div class="metric"><div class="metric-label">Total acumulado</div><div class="metric-val">${fmt(total)}</div></div>
    <div class="metric"><div class="metric-label">Ya pagado</div><div class="metric-val" style="color:var(--green)">${fmt(pagado)}</div></div>
    <div class="metric"><div class="metric-label">Por pagar</div><div class="metric-val" style="color:var(--amber)">${fmt(pendiente)}</div></div>
    <div class="metric"><div class="metric-label">Proyección cierre</div><div class="metric-val">${fmt(total*1.07)}</div><div class="metric-sub up">estimado</div></div>
  `
  const top5 = [...gastos].sort((a,b) => Number(b.monto)-Number(a.monto)).slice(0,5)
  const maxM = Number(top5[0]?.monto || 1)
  document.getElementById('top-gastos').innerHTML = top5.map(g => {
    const pct = Math.round(Number(g.monto)/maxM*100)
    return `<div class="bar-wrap">
      <div class="bar-label"><span>${g.descripcion}</span><span>${fmt(g.monto)}</span></div>
      <div class="bar-track"><div class="bar-fill" style="width:${pct}%;background:#3b82f6"></div></div>
    </div>`
  }).join('')

  const cats = {}
  gastos.forEach(g => { cats[g.categoria] = (cats[g.categoria]||0) + Number(g.monto) })
  const catSort = Object.entries(cats).sort((a,b) => b[1]-a[1])
  const barColors = ['#3b82f6','#22c55e','#f59e0b','#a78bfa','#ef4444']
  document.getElementById('dist-cat').innerHTML = catSort.map(([c,v],i) => {
    const pct = Math.round(v/total*100)
    return `<div class="stat-row"><span>${c}</span><span style="color:${barColors[i%barColors.length]};font-weight:500">${pct}% · ${fmt(v)}</span></div>`
  }).join('')

  const epec = [{mes:'Mar',val:120000},{mes:'Abr',val:138000},{mes:'May',val:171000}]
  const maxE = 171000
  document.getElementById('hist-comparador').innerHTML = `
    <div style="font-size:12px;color:var(--text2);margin-bottom:12px">
      Variación: Abr → May <strong style="color:var(--red)">+23.9%</strong>
      <span style="background:var(--red-bg);color:var(--red);padding:2px 8px;border-radius:10px;font-size:11px;margin-left:8px">Aumento anormal</span>
    </div>
    ${epec.map(e => `
      <div class="bar-wrap">
        <div class="bar-label"><span>${e.mes} 2026</span><span>${fmt(e.val)}</span></div>
        <div class="bar-track"><div class="bar-fill" style="width:${Math.round(e.val/maxE*100)}%;background:${e.val===maxE?'var(--red)':'#3b82f6'}"></div></div>
      </div>`).join('')}
    <div style="font-size:12px;color:var(--text2);margin-top:10px">Promedio trimestral: ${fmt((120000+138000+171000)/3)} · Diferencia actual: <span style="color:var(--red)">+19.5%</span></div>
  `
}

// GUARDAR GASTO
async function guardarGasto() {
  const desc = document.getElementById('f-desc').value.trim()
  const monto = parseFloat(document.getElementById('f-monto').value) || 0
  if (!desc || !monto) { alert('Completá descripción y monto'); return }
  const nuevo = {
    descripcion: desc,
    categoria: document.getElementById('f-cat').value,
    tipo: document.getElementById('f-tipo').value,
    monto,
    fecha_vencimiento: document.getElementById('f-fecha').value || todayStr,
    estado: document.getElementById('f-estado').value,
    prioridad: document.getElementById('f-prioridad').value,
    medio_pago: document.getElementById('f-medio').value,
    recurrente: document.getElementById('f-recurrente').value,
    observaciones: document.getElementById('f-obs').value
  }
  if (!DEMO_MODE) {
    const { data, error } = await db.from('gastos').insert([nuevo]).select()
    if (!error && data) gastos.unshift(data[0])
  } else {
    gastos.unshift({ id: 'demo-' + Date.now(), ...nuevo })
  }
  closeModal()
  document.getElementById('f-desc').value = ''
  document.getElementById('f-monto').value = ''
  document.getElementById('f-obs').value = ''
  renderDashboard()
}

// MARCAR PAGADO
async function marcarPagado(id) {
  if (!DEMO_MODE) {
    await db.from('gastos').update({ estado: 'Pagado', fecha_pago: todayStr }).eq('id', id)
  }
  const g = gastos.find(x => x.id == id)
  if (g) { g.estado = 'Pagado'; g.fecha_pago = todayStr }
  renderVenc()
}

function openModal() {
  document.getElementById('f-fecha').value = todayStr
  document.getElementById('modal-overlay').classList.add('open')
}
function closeModal() { document.getElementById('modal-overlay').classList.remove('open') }

function copiarSQL() {
  const sql = `create table gastos (
  id uuid default gen_random_uuid() primary key,
  descripcion text not null,
  categoria text,
  tipo text default 'Fijo',
  monto numeric not null default 0,
  fecha_vencimiento date,
  fecha_pago date,
  estado text default 'Pendiente',
  prioridad text default 'Media',
  medio_pago text,
  recurrente text default 'No',
  observaciones text,
  created_at timestamptz default now()
);
alter table gastos enable row level security;
create policy "public access" on gastos for all using (true);`
  navigator.clipboard.writeText(sql).then(() => alert('SQL copiado al portapapeles'))
}

// INIT
async function init() {
  await cargarGastos()
  renderDashboard()
}
init()
</script>
</body>
</html>
